@startuml ProTimer_StateMachine
!theme plain
skinparam backgroundColor white
skinparam state {
    BackgroundColor<<idle>> LightYellow
    BackgroundColor<<time_set>> LightYellow
    BackgroundColor<<stats>> LightYellow
    BackgroundColor<<paused>> LightYellow
    BackgroundColor<<countdown>> LightYellow
}

state "Pro Timer System" as ProTimer {
    
    [*] --> IDLE : mobj->worked_time=0;
    
    state "IDLE" as IDLE <<idle>> {
        IDLE: entry /  mobj->current_time=0; mobj->elapsed_time=0; display_time(0); display_message("Set Time");

        IDLE: \nexit /  displ_clear();

    }
    
    state "TIME_SET" as TIME_SET <<time_set>> {
        TIME_SET: entry / disp_time(mobj->current_time);
    }
    
    state "PAUSE" as PAUSE <<paused>> {
        PAUSE: entry / disp_msg("Paused");
        
        PAUSE: \nexit / displ_clear();

    }

    state "COUNTDOWN" as COUNTDOWN <<countdown>> {

    }

    state "STATS" as STATS <<stats>> {
        STATS: entry / disp_time(mobj->worked_time); disp_msg("Worked Time");
        STATS: exit / displ_clear();
    }

}

@enduml